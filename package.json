{
  "name": "prisma-cold-start-retry",
  "version": "0.1.0",
  "description": "Prisma Client extension that retries queries when a serverless database (Neon, Supabase...) was asleep and the first connection fails.",
  "keywords": ["prisma", "prisma-extension", "neon", "serverless", "retry", "cold-start", "postgres", "P1001"],
  "license": "MIT",
  "author": "Renan Pivetta",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist", "README.md", "LICENSE"],
  "sideEffects": false,
  "engines": { "node": ">=18" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test test/unit.test.mjs",
    "test:integration": "npm run build && prisma generate --schema test/schema.prisma && node --test test/integration.test.mjs",
    "prepublishOnly": "npm test"
  },
  "peerDependencies": {
    "@prisma/client": ">=4.16.0"
  },
  "devDependencies": {
    "@prisma/client": "^5.22.0",
    "@types/node": "^22.0.0",
    "prisma": "^5.22.0",
    "typescript": "^5.6.3"
  }
}
